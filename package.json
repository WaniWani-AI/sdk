{
  "name": "waniwani-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/kit/examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/chat build && bun run --cwd packages/sdk build && bun run --cwd packages/cli build && bun run --cwd packages/kit build",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/chat typecheck && bun run --cwd packages/sdk typecheck && bun run --cwd packages/cli typecheck && bun run --cwd packages/kit typecheck",
    "contract": "bun packages/kit/scripts/template-contract.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "bun test",
    "eval:flows": "bun run --cwd packages/sdk eval:flows",
    "storybook": "bun run --cwd packages/chat storybook",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.3.12",
    "@types/node": "^22.10.0",
    "lefthook": "^2.0.16",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "zod": "^4.0.0"
  }
}
