{
  "name": "waniwani-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/chat build && bun run --cwd packages/sdk build",
    "typecheck": "tsc --noEmit && bun run --cwd packages/protocol typecheck && bun run --cwd packages/chat typecheck && bun run --cwd packages/sdk typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "bun test",
    "eval:flows": "bun run --cwd packages/sdk eval:flows",
    "storybook": "bun run --cwd packages/chat storybook",
    "postinstall": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.12",
    "@types/node": "^22.10.0",
    "lefthook": "^2.0.16",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "zod": "^4.0.0"
  }
}
