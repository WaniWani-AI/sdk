# Optional. Without it the app still runs: flows use MemoryKvStore and
# withWaniwani degrades to a no-op. With it, flow state is hosted and tracking
# reaches app.waniwani.ai.
WANIWANI_API_KEY=

# Optional. What /.well-known/openai-apps-challenge answers with, so OpenAI can
# verify this deployment belongs to us. Issued per origin, so preview and
# production each set their own; unset, the path answers 404.
OPENAI_APPS_CHALLENGE_TOKEN=
