{
  "name": "@waniwani/chat",
  "version": "0.25.4-beta.0",
  "description": "Waniwani chat widget: the WaniwaniChat and ChatEmbed React components, their themes, and embed.js, the script tag for any website.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./embed.js": "./dist/embed.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run typecheck && tsup && bun run build:css && bun run build:embed-css && bun run check:browser-bundles",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/styles.css --minify",
    "build:embed-css": "bun scripts/inline-embed-css.ts",
    "check:browser-bundles": "bun scripts/check-browser-bundles.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "bun run build",
    "release": "bun run release:patch",
    "release:patch": "bun ../../scripts/bump.ts patch",
    "release:minor": "bun ../../scripts/bump.ts minor",
    "release:major": "bun ../../scripts/bump.ts major",
    "release:beta": "bun ../../scripts/bump.ts beta",
    "release:alpha": "bun ../../scripts/bump.ts alpha"
  },
  "peerDependencies": {
    "@ai-sdk/react": ">=1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": ">=6.0.141",
    "react": ">=18.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.134",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@storybook/react-vite": "^10.4.6",
    "@streamdown/cjk": "^1.0.1",
    "@streamdown/code": "^1.0.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ai": "^6.0.141",
    "clsx": "^2.1.1",
    "eve": "0.68.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.7.0",
    "lucide-react": "^0.563.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.2.4",
    "storybook": "^10.5.2",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "use-stick-to-bottom": "^1.1.3",
    "vite": "^8.1.0",
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WaniWani-AI/sdk",
    "directory": "packages/chat"
  },
  "keywords": [
    "waniwani",
    "chat",
    "chat-widget",
    "embed",
    "mcp",
    "mcp-apps",
    "react",
    "ai"
  ],
  "author": "Waniwani",
  "license": "MIT"
}
