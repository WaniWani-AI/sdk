{
	"$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
	"files": {
		"includes": [
			"packages/*/src/**",
			"packages/*/scripts/**",
			"packages/sdk/evals/**",
			"packages/kit/cli/**",
			"packages/kit/templates/**",
			"packages/kit/examples/**",
			"!packages/chat/src/tailwind.css",
			"!!**/.waniwani",
			"!!**/dist",
			"!!**/node_modules"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noArrayIndexKey": "off"
			},
			"style": {
				"useBlockStatements": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"overrides": [
		{
			"includes": ["packages/kit/**", "packages/cli/**"],
			"linter": {
				"rules": {
					"style": {
						"useBlockStatements": "off"
					}
				}
			},
			"formatter": {
				"lineWidth": 100
			},
			"json": {
				"parser": {
					"allowComments": true
				}
			}
		}
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
